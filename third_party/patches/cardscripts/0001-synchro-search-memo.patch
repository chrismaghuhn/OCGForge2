+--Synchro.Condition reaches the same material set once for every order its recursion can pick the
+--cards in. The checks of each pick still run for every order; what follows a pick only depends on
+--the picked tuners and non-tuners and on the candidates left (sg is their union), so while
+--Synchro.Condition searches (SearchMemo set) it is computed once per such state.
+function Synchro.SearchKey(step,tsg,ntsg,tg,ntg)
+	local parts={step}
+	for _,g in ipairs({tsg,ntsg,tg or Group.CreateGroup(),ntg}) do
+		local ids={}
+		for tc in g:Iter() do ids[#ids+1]=tc:GetFieldID() end
+		table.sort(ids)
+		parts[#parts+1]=table.concat(ids,",")
+	end
+	return table.concat(parts,";")
+end

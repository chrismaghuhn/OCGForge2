 using namespace scriptlib;
 
+namespace {
+void lua_budget_hook(lua_State* L, lua_Debug*) {
+	duel* pduel;
+	std::memcpy(&pduel, lua_getextraspace(L), sizeof(duel*));
+	if(++pduel->lua_budget_ticks > duel::LUA_BUDGET_TICKS) {
+		pduel->lua_budget_exceeded = true;
+		luaL_error(L, "Lua instruction budget exceeded");
+	}
+}
+}

 	return static_cast<duel*>(ocg_duel)->lua->heap.extent().second;
 }
 
+int OCG_DuelSetLuaGenerationalGC(OCG_Duel ocg_duel, int generational) {
+	auto* L = static_cast<duel*>(ocg_duel)->lua->lua_state;
+	const int previous = generational ? lua_gc(L, LUA_GCGEN, 0, 0) : lua_gc(L, LUA_GCINC, 0, 0, 0);
+	return previous == LUA_GCGEN;
+}
+
+void OCG_DuelCollectLuaGarbage(OCG_Duel ocg_duel) {
+	lua_gc(static_cast<duel*>(ocg_duel)->lua->lua_state, LUA_GCCOLLECT, 0);
+}

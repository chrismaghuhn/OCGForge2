--- a/lua/src/ldo.c
+++ b/lua/src/ldo.c
@@ -520,10 +520,29 @@
 /*
 ** precall for C functions
 */
+/*
+** Call budget (lua_setcallbudget): every function call counts, and past the
+** budget calls raise an error, so a script searching an exploding number of
+** combinations fails instead of running for hours. Cheaper than a count hook,
+** which makes the VM check every instruction. After an error the next few
+** calls still pass, so error handlers can run.
+*/
+static void callbudgeterror (lua_State *L) {
+  global_State *g = G(L);
+  g->callbudgetexceeded = 1;
+  g->callbudget = g->callcount + 64;
+  luaG_runerror(L, "Lua call budget exceeded");
+}
+
+#define countcall(L) \
+  { if (l_unlikely(++G(L)->callcount > G(L)->callbudget)) callbudgeterror(L); }
+
+
 l_sinline int precallC (lua_State *L, StkId func, int nresults,
                                             lua_CFunction f) {
   int n;  /* number of returns */
   CallInfo *ci;
+  countcall(L);
   checkstackGCp(L, LUA_MINSTACK, func);  /* ensure minimum stack size */
   L->ci = ci = prepCallInfo(L, func, nresults, CIST_C,
                                L->top.p + LUA_MINSTACK);
@@ -560,6 +579,7 @@
       int fsize = p->maxstacksize;  /* frame size */
       int nfixparams = p->numparams;
       int i;
+      countcall(L);
       checkstackGCp(L, fsize - delta, func);
       ci->func.p -= delta;  /* restore 'func' (if vararg) */
       for (i = 0; i < narg1; i++)  /* move down function and arguments */
@@ -604,6 +624,7 @@
     case LUA_VLCL: {  /* Lua function */
       CallInfo *ci;
       Proto *p = clLvalue(s2v(func))->p;
+      countcall(L);

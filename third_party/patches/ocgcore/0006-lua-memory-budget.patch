+LUA_API void lua_setmemlimit (lua_State *L, lua_Unsigned limit) {
+  G(L)->memlimit = cast(lu_mem, limit);
+}
+
+
+LUA_API lua_Unsigned lua_memused (lua_State *L) {
+  return gettotalbytes(G(L));
+}
+
+
+LUA_API lua_Unsigned lua_mempeak (lua_State *L) {
+  global_State *g = G(L);
+  return g->mempeak > gettotalbytes(g) ? g->mempeak : gettotalbytes(g);
+}
+
+
+LUA_API int lua_memlimitexceeded (lua_State *L) {
+  return G(L)->memlimitexceeded;
+}
diff --git a/lua/src/lmem.c b/lua/src/lmem.c
--- a/lua/src/lmem.c
+++ b/lua/src/lmem.c
@@ -48,6 +48,38 @@
 
 
 /*
+** Memory limit (lua_setmemlimit). It wraps the allocation function: a
+** request that would take the state past the limit fails as if the
+** allocator had run out of memory, so Lua runs an emergency collection
+** and then raises LUA_ERRMEM. It only applies once the limit is set
+** (after the state is built, so never inside lua_newstate) and only where
+** the error can be caught: an allocation made outside every protected call
+** (e.g. ocgcore creating a group from C++) would otherwise abort the
+** process, so it may go past the limit. 'os' of a new block is its type
+** tag, not a size.
+*/
+#define overlimit(L,g,block,os,ns) \
+  ((g)->memlimit != 0 && \
+   (ns) > ((block) ? (os) : 0) && \
+   gettotalbytes(g) + ((ns) - ((block) ? (os) : 0)) > (g)->memlimit && \
+   ((L)->errorJmp != NULL || (g)->mainthread->errorJmp != NULL))
+
+static void *limitedrealloc (lua_State *L, void *block, size_t os,
+                                                        size_t ns) {
+  global_State *g = G(L);
+  if (l_unlikely(overlimit(L, g, block, os, ns)))
+    return NULL;
+  return callfrealloc(g, block, os, ns);
+}
+
+static void notemempeak (global_State *g) {
+  lu_mem total = gettotalbytes(g);
+  if (total > g->mempeak)
+    g->mempeak = total;
+}
+
+
+/*
 ** When an allocation fails, it will try again after an emergency
 ** collection, except when it cannot run a collection.  The GC should
 ** not be called while the state is not fully built, as the collector
@@ -66,14 +98,14 @@
 ** fail) and when it cannot try again; this fail will trigger 'tryagain'
 ** and a full GC cycle at every allocation.
 */
-static void *firsttry (global_State *g, void *block, size_t os, size_t ns) {
+static void *firsttry (lua_State *L, global_State *g, void *block, size_t os, size_t ns) {
   if (ns > 0 && cantryagain(g))
     return NULL;  /* fail */
   else  /* normal allocation */
-    return callfrealloc(g, block, os, ns);
+    return limitedrealloc(L, block, os, ns);
 }
 #else
-#define firsttry(g,block,os,ns)    callfrealloc(g, block, os, ns)
+#define firsttry(L,g,block,os,ns)    limitedrealloc(L, block, os, ns)
 #endif
 
 
@@ -162,11 +194,14 @@
 static void *tryagain (lua_State *L, void *block,
                        size_t osize, size_t nsize) {
   global_State *g = G(L);
+  void *newblock = NULL;
   if (cantryagain(g)) {
     luaC_fullgc(L, 1);  /* try to free some memory... */
-    return callfrealloc(g, block, osize, nsize);  /* try again */
+    newblock = limitedrealloc(L, block, osize, nsize);  /* try again */
   }
-  else return NULL;  /* cannot run an emergency collection */
+  if (newblock == NULL && overlimit(L, g, block, osize, nsize))
+    g->memlimitexceeded = 1;  /* failing because of the limit */
+  return newblock;
 }
 
 
@@ -177,7 +212,7 @@
   void *newblock;
   global_State *g = G(L);
   lua_assert((osize == 0) == (block == NULL));
-  newblock = firsttry(g, block, osize, nsize);
+  newblock = firsttry(L, g, block, osize, nsize);
   if (l_unlikely(newblock == NULL && nsize > 0)) {
     newblock = tryagain(L, block, osize, nsize);
     if (newblock == NULL)  /* still no memory? */
@@ -185,6 +220,8 @@
   }
   lua_assert((nsize == 0) == (newblock == NULL));
   g->GCdebt = (g->GCdebt + nsize) - osize;
+  if (nsize > osize)
+    notemempeak(g);
   return newblock;
 }
 
@@ -203,13 +240,14 @@
     return NULL;  /* that's all */
   else {
     global_State *g = G(L);
-    void *newblock = firsttry(g, NULL, tag, size);
+    void *newblock = firsttry(L, g, NULL, tag, size);
     if (l_unlikely(newblock == NULL)) {
       newblock = tryagain(L, NULL, tag, size);
       if (newblock == NULL)
         luaM_error(L);
     }
     g->GCdebt += size;
+    notemempeak(g);
     return newblock;
   }
 }
